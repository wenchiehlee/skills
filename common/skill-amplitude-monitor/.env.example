# Amplitude API Credentials
# Get them from: Amplitude Settings > Projects > [Project Name] > Project Details
AMPLITUDE_API_KEY=your_amplitude_api_key_here
AMPLITUDE_SECRET_KEY=your_amplitude_secret_key_here

# Optional: Default Project Name or ID (for documentation/reports)
AMPLITUDE_PROJECT_NAME=wenchiehlee
AMPLITUDE_PROJECT_ID=509408

# Optional: Data Region (default is US: https://amplitude.com/api/2)
# For EU residency, set AMPLITUDE_API_BASE=https://analytics.eu.amplitude.com/api/2
AMPLITUDE_API_BASE=https://amplitude.com/api/2
