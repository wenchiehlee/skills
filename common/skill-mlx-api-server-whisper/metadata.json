{
  "name": "mlx-api-server-whisper",
  "description": "Mac-mini 上以 self-hosted GitHub Actions runner 執行的語音轉錄 pipeline（whisper 轉錄 → LLM postprocess → CER 校驗 → GT 校正迴圈），透過 issue 驅動、支援多種音訊來源（法說會、YouTube 財經影片…）。",
  "category": "server",
  "version": "2.0.0",
  "author": "wenchiehlee",
  "maintainer": "wenchiehlee",
  "source": "https://github.com/wenchiehlee/Mac-mini/tree/main/skills/skill-mlx-api-server-whisper/scripts",
  "updated_at": "2026-08-07",
  "license": "MIT",
  "tags": [
    "server",
    "whisper",
    "mlx",
    "faster-whisper",
    "cer",
    "asr",
    "mac-mini",
    "github-actions",
    "self-hosted-runner",
    "youtube"
  ],
  "compatibility": {
    "platform": "macOS (Apple Silicon)",
    "python": ">=3.10",
    "requires": [
      "mlx-whisper",
      "faster-whisper",
      "pyyaml",
      "opencc-python-reimplemented",
      "httpx",
      "python-dotenv",
      "jiwer",
      "amplitude-analytics"
    ],
    "secrets": [
      "REPO_FILE_SYNC_WENCHIEHLEE_MONEY",
      "HF_TOKEN",
      "AMPLITUDE_API_KEY"
    ]
  },
  "files": [
    "SKILL.md",
    "metadata.json",
    "self_update.py",
    "scripts/whisper_poc.py",
    "scripts/postprocess.py",
    "scripts/verify_cer.py",
    "scripts/analytics/__init__.py",
    "scripts/analytics/amplitude.py",
    "scripts/add_punctuation.py",
    "scripts/align_transcript_to_fin.py",
    "scripts/analyze_critical.py",
    "scripts/audio_utils.py",
    "scripts/benchmark.py",
    "scripts/check_arch.py",
    "scripts/convert_md_to_srt.py",
    "scripts/convert_yt_to_gt.py",
    "scripts/cut_sample.py",
    "scripts/diff_char.py",
    "scripts/extract_stage.py",
    "scripts/gen_cer_difference.py",
    "scripts/gen_stage_gt.py",
    "scripts/get_top_exps.py",
    "scripts/llm_merge_review.py",
    "scripts/merge_transcripts.py",
    "scripts/probe_mlx_chunk_limit.py",
    "scripts/probe_mlx_per_seg.py",
    "scripts/probe_mlx_truncation.py",
    "scripts/select_best_exp.py",
    "scripts/whisper_exp.py"
  ],
  "deployments": [
    {
      "repo": "wenchiehlee/skills",
      "local_path": "github.com/skills/common/skill-mlx-api-server-whisper",
      "role": "registry"
    },
    {
      "repo": "wenchiehlee/Mac-mini",
      "local_path": "github.com/Mac-mini/skills/skill-mlx-api-server-whisper",
      "role": "consumer"
    }
  ],
  "registry": "https://github.com/wenchiehlee/skills/tree/main/common/skill-mlx-api-server-whisper"
}
