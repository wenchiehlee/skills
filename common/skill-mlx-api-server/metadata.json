{
  "name": "skill-mlx-api-server",
  "description": "在 Mac-mini (Apple Silicon M4) 本機執行的 AI 推理服務，提供 Baidu Unlimited-OCR 與 PaddleOCR-VL-1.6 文件轉錄（共用單一 FIFO worker）及 MLX LLM 推理（/exec），以 Flask/Waitress 常駐服務形式運行。",
  "category": "server",
  "version": "1.2.0",
  "author": "wenchiehlee",
  "maintainer": "wenchiehlee",
  "source": "https://github.com/wenchiehlee/Mac-mini/tree/main/skills/skill-mlx-api-server/scripts",
  "updated_at": "2026-09-30",
  "license": "MIT",
  "tags": [
    "server",
    "mlx",
    "ocr",
    "llm",
    "qwen3",
    "gemma4",
    "baidu-ocr",
    "paddleocr-vl",
    "flask",
    "mac-mini",
    "launchd",
    "amplitude"
  ],
  "compatibility": {
    "platform": "macOS (Apple Silicon)",
    "python": ">=3.11",
    "requires_file": "scripts/requirements.txt",
    "env": [
      "MLX_SERVER_API_KEY",
      "MLX_SERVER_HOST",
      "MLX_ALLOWED_MODELS"
    ]
  },
  "files": [
    "SKILL.md",
    "metadata.json",
    "self_update.py",
    "scripts/server.py",
    "scripts/auth.py",
    "scripts/config.py",
    "scripts/executor.py",
    "scripts/ocr_run.py",
    "scripts/paddleocr_run.py",
    "scripts/requirements-paddle.txt",
    "scripts/test_ocr_queue.py",
    "scripts/bench_params.py",
    "scripts/test_qwen3_thinking.py",
    "scripts/requirements.txt"
  ],
  "deployments": [
    {
      "repo": "wenchiehlee/skills",
      "local_path": "github.com/skills/common/skill-mlx-api-server",
      "role": "registry"
    },
    {
      "repo": "wenchiehlee/Mac-mini",
      "local_path": "github.com/Mac-mini/skills/skill-mlx-api-server",
      "role": "consumer"
    }
  ],
  "registry": "https://github.com/wenchiehlee/skills/tree/main/common/skill-mlx-api-server"
}
