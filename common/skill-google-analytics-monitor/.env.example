# GA4 Property ID (numeric property ID, e.g. 463673189)
GOOGLE_ANALYTICS_KEY=463673189
GA_SITE_NAME=Analytics-Deck / ZhongZheng782

# Authentication: Service Account Key (JSON string or file path)
GA4_SERVICE_ACCOUNT_KEY=service_account_ga4.json

# Optional: Path Filter for multi-site properties (e.g. /mkdocs-life/ or /mkdocs-investment/)
# GA_FILTER_PATH=/mkdocs-life/

# Report Settings
GA_REPORT_MONTHS=3
GA_INCLUDE_SHORT_WINDOWS=7,28
GA_REPORT_OUTPUT=README.md
GA_JSON_DIR=reports/ga-monitor-json
GA_REPORT_SHOW_PROPERTY_ID=false
GA_CLI_BIN=ga
